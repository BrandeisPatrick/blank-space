{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://blank-space-29ea4.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/((?!api/|@|src/|node_modules/|images/|icons/|docs/).*)",
      "destination": "/index.html"
    }
  ]
}
