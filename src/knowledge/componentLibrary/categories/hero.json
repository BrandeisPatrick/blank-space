      "code": "function HeroMinimalDark() {\n  return (\n    <section className=\"relative min-h-screen bg-neutral-950 flex items-center justify-center\">\n      {/* Subtle gradient */}\n      <div className=\"absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]\" />\n      {/* Content */}\n      <div className=\"relative z-10 text-center px-6 max-w-4xl mx-auto\">\n        <h1 className=\"text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 tracking-tight\">\n          Design. Build.\n          <span className=\"block text-neutral-500\">Ship faster.</span>\n        </h1>\n        <p className=\"text-lg md:text-xl text-neutral-400 mb-10 max-w-xl mx-auto\">\n          A minimal, professional approach to building modern web applications.\n        </p>\n        <div className=\"flex items-center justify-center gap-4\">\n          <button className=\"px-6 py-3 bg-white text-black font-medium rounded-lg hover:bg-neutral-200 transition-colors\">\n            Get Started\n          </button>\n          <button className=\"px-6 py-3 text-neutral-400 font-medium hover:text-white transition-colors flex items-center gap-2\">\n            <span>Documentation</span>\n            <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 5l7 7-7 7\" />\n            </svg>\n          </button>\n        </div>\n      </div>\n    </section>\n  );\n}"
    },
    {
      "id": "hero-split-image",
      "name": "Split Image Hero",
      "description": "Hero with content on one side and image on the other, great for product showcases",
      "source": "Custom",
      "tags": ["hero", "split", "image", "product", "showcase", "two-column"],
      "useCases": ["product pages", "app landing pages", "feature showcases", "marketing sites"],
      "code": "function HeroSplitImage() {\n  return (\n    <section className=\"min-h-screen bg-white\">\n      <div className=\"max-w-7xl mx-auto px-6 py-20\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-12 items-center min-h-[80vh]\">\n          {/* Content */}\n          <div>\n            <div className=\"inline-block mb-6 px-3 py-1 bg-blue-100 text-blue-700 text-sm font-medium rounded-full\">\n              New Release\n            </div>\n            <h1 className=\"text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight\">\n              The future of\n              <span className=\"text-blue-600\"> productivity</span>\n            </h1>\n            <p className=\"text-xl text-gray-600 mb-8 leading-relaxed\">\n              Streamline your workflow with our intelligent platform. Built for teams who want to move fast.\n            </p>\n            <div className=\"flex items-center gap-4 flex-wrap\">\n              <button className=\"px-8 py-4 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors shadow-lg shadow-blue-600/25\">\n                Start Free Trial\n              </button>\n              <button className=\"px-8 py-4 border-2 border-gray-200 text-gray-700 font-semibold rounded-xl hover:border-gray-300 transition-colors\">\n                Book a Demo\n              </button>\n            </div>\n            {/* Trust badges */}\n            <div className=\"mt-12 flex items-center gap-6\">\n              <p className=\"text-sm text-gray-500\">Trusted by</p>\n              <div className=\"flex items-center gap-6 opacity-50\">\n                <div className=\"text-2xl font-bold text-gray-400\">ACME</div>\n                <div className=\"text-2xl font-bold text-gray-400\">CORP</div>\n                <div className=\"text-2xl font-bold text-gray-400\">INC</div>\n              </div>\n            </div>\n          </div>\n          {/* Image */}\n          <div className=\"relative\">\n            <div className=\"aspect-square bg-gradient-to-br from-blue-500 to-purple-600 rounded-3xl shadow-2xl overflow-hidden\">\n              <img \n                src=\"https://images.unsplash.com/photo-1551434678-e076c223a692?w=800&h=800&fit=crop\" \n                alt=\"Product showcase\"\n                className=\"w-full h-full object-cover mix-blend-overlay opacity-80\"\n              />\n            </div>\n            {/* Floating card */}\n            <div className=\"absolute -bottom-6 -left-6 bg-white p-6 rounded-2xl shadow-xl border border-gray-100\">\n              <div className=\"flex items-center gap-4\">\n                <div className=\"w-12 h-12 bg-green-100 rounded-full flex items-center justify-center\">\n                  <svg className=\"w-6 h-6 text-green-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M5 13l4 4L19 7\" />\n                  </svg>\n                </div>\n                <div>\n                  <div className=\"font-semibold text-gray-900\">99% Uptime</div>\n                  <div className=\"text-sm text-gray-500\">Enterprise reliability</div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}"
