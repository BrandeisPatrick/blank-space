  "components": [
    {
      "id": "hero-spotlight",
      "name": "Spotlight Hero",
      "description": "Dark hero section with spotlight radial gradient effect, perfect for SaaS and tech products",
      "source": "Aceternity UI",
      "tags": ["hero", "spotlight", "dark", "gradient", "landing-page", "saas", "tech"],
      "useCases": ["SaaS landing pages", "tech products", "startup sites", "developer tools"],
      "code": "function HeroSpotlight() {\n  return (\n    <section className=\"relative min-h-screen bg-black overflow-hidden flex items-center justify-center\">\n      {/* Spotlight effect */}\n      <div \n        className=\"absolute inset-0 pointer-events-none\"\n        style={{\n          background: 'radial-gradient(circle at 50% 40%, rgba(120, 119, 198, 0.3) 0%, transparent 50%)',\n        }}\n      />\n      {/* Grid pattern overlay */}\n      <div \n        className=\"absolute inset-0 pointer-events-none opacity-20\"\n        style={{\n          backgroundImage: 'linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px)',\n          backgroundSize: '50px 50px',\n        }}\n      />\n      {/* Content */}\n      <div className=\"relative z-10 text-center px-6 max-w-5xl mx-auto\">\n        <div className=\"inline-block mb-6 px-4 py-2 rounded-full border border-purple-500/30 bg-purple-500/10\">\n          <span className=\"text-purple-400 text-sm font-medium\">Introducing our new platform</span>\n        </div>\n        <h1 className=\"text-5xl md:text-7xl font-bold text-white mb-6 leading-tight\">\n          Build amazing products\n          <span className=\"block bg-gradient-to-r from-purple-400 via-pink-500 to-red-500 bg-clip-text text-transparent\">\n            faster than ever\n          </span>\n        </h1>\n        <p className=\"text-xl text-gray-400 mb-10 max-w-2xl mx-auto leading-relaxed\">\n          The modern platform for building, deploying, and scaling your applications with ease.\n        </p>\n        <div className=\"flex items-center justify-center gap-4 flex-wrap\">\n          <button className=\"px-8 py-4 bg-white text-black font-semibold rounded-full hover:bg-gray-100 transition-all hover:scale-105 shadow-lg shadow-white/25\">\n            Get Started Free\n          </button>\n          <button className=\"px-8 py-4 border border-gray-700 text-white font-semibold rounded-full hover:bg-white/5 transition-all flex items-center gap-2\">\n            <span>Watch Demo</span>\n            <svg className=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n              <path d=\"M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z\" />\n            </svg>\n          </button>\n        </div>\n      </div>\n    </section>\n  );\n}"
    },
    {
      "id": "hero-gradient-mesh",
      "name": "Gradient Mesh Hero",
      "description": "Vibrant hero with animated mesh gradient background, glassmorphism cards, and modern typography",
      "source": "Magic UI",
      "tags": ["hero", "gradient", "mesh", "colorful", "glassmorphism", "animated", "modern"],
      "useCases": ["creative agencies", "portfolios", "product launches", "startups"],
      "code": "function HeroGradientMesh() {\n  return (\n    <section className=\"relative min-h-screen overflow-hidden\">\n      {/* Animated gradient background */}\n      <div className=\"absolute inset-0 bg-gradient-to-br from-violet-500 via-purple-500 to-fuchsia-500\">\n        <div className=\"absolute top-0 -left-4 w-96 h-96 bg-purple-300 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-pulse\" style={{animationDuration: '8s'}} />\n        <div className=\"absolute top-0 -right-4 w-96 h-96 bg-yellow-300 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-pulse\" style={{animationDuration: '10s', animationDelay: '2s'}} />\n        <div className=\"absolute -bottom-8 left-20 w-96 h-96 bg-pink-300 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-pulse\" style={{animationDuration: '12s', animationDelay: '4s'}} />\n      </div>\n      {/* Content */}\n      <div className=\"relative z-10 min-h-screen flex items-center justify-center px-6\">\n        <div className=\"text-center max-w-4xl mx-auto\">\n          <div className=\"inline-flex items-center gap-2 mb-8 px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full border border-white/30\">\n            <span className=\"w-2 h-2 bg-green-400 rounded-full animate-pulse\" />\n            <span className=\"text-white text-sm font-medium\">Now available worldwide</span>\n          </div>\n          <h1 className=\"text-5xl md:text-7xl font-bold text-white mb-6 leading-tight drop-shadow-lg\">\n            Create stunning\n            <span className=\"block\">experiences</span>\n          </h1>\n          <p className=\"text-xl text-white/90 mb-10 max-w-2xl mx-auto leading-relaxed\">\n            Transform your ideas into reality with our powerful design tools and seamless workflow.\n          </p>\n          <div className=\"flex items-center justify-center gap-4 flex-wrap\">\n            <button className=\"px-8 py-4 bg-white text-purple-600 font-bold rounded-2xl hover:bg-white/90 transition-all hover:scale-105 shadow-2xl\">\n              Start Creating\n            </button>\n            <button className=\"px-8 py-4 bg-white/10 backdrop-blur-sm text-white font-semibold rounded-2xl border border-white/30 hover:bg-white/20 transition-all\">\n              Learn More\n            </button>\n          </div>\n          {/* Stats */}\n          <div className=\"mt-16 grid grid-cols-3 gap-8 max-w-lg mx-auto\">\n            <div className=\"text-center\">\n              <div className=\"text-3xl font-bold text-white\">10K+</div>\n              <div className=\"text-white/70 text-sm\">Users</div>\n            </div>\n            <div className=\"text-center\">\n              <div className=\"text-3xl font-bold text-white\">50M+</div>\n              <div className=\"text-white/70 text-sm\">Downloads</div>\n            </div>\n            <div className=\"text-center\">\n              <div className=\"text-3xl font-bold text-white\">99%</div>\n              <div className=\"text-white/70 text-sm\">Satisfaction</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}"
    },
    {
      "id": "hero-minimal-dark",
      "name": "Minimal Dark Hero",
      "description": "Clean, minimal dark hero with subtle animations and professional typography",
